# ============================================================
# Hermes Stealth Stack — environment variables
# Copy this file to .env and adjust values.
# ============================================================

DOCKER_NETWORK=ai-net

# Internal ports (usually no need to change)
CAMOFOX_PORT=9377
ROUTER_PORT=9378
SEARXNG_PORT=8080
SOLVERR_PORT=8191

# Service URLs (for Hermes integration)
SEARXNG_URL=http://searxng:8080
SOLVERR_URL=http://solverr:8191

# Firefox preferences for Camofox (WebRTC off, remote DNS)
CAMOFOX_PREFS_PATH=./camofox/prefs/user.js

# Camofox backends
CAMOFOX_VPS_URL=http://camofox:9377
CAMOFOX_TOR_URL=http://camofox-tor:9377
CAMOFOX_I2P_URL=http://camofox-i2p:9377

# Proxy containers
TOR_SOCKS_HOST=tor-proxy
TOR_SOCKS_PORT=9150
I2P_HTTP_HOST=i2p-proxy
I2P_HTTP_PORT=4444
