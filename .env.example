#
# IMPORTANTE — riproducibilita' di Camofox
# =========================================
# I container camofox* girano con l'immagine locale
# hermes-stealth/camofox:1.0.3 (build da ./camofox/Dockerfile), non con
# CAMOFOX_IMAGE. Il file docker-compose.override.yml e' caricato da
# Docker Compose in automatico e forza quel build + le preferenze privacy
# (block_webrtc) + il Tor dedicato (tor-proxy-camofox).
#
# NON usare: docker compose -f docker-compose.yml up
# (bypassa l'override, perdi prefs privacy e Tor separato)
#
# Usa sempre: docker compose up -d [servizio]
# oppure:     docker compose up -d --no-deps [servizio]

# ============================================================
# Hermes Stealth Stack — environment variables
# Copy this file to .env and adjust values.
# ============================================================

DOCKER_NETWORK=ai-net

# Docker images (change to pin specific versions for reproducibility)
# Get a digest with: docker pull <image> && docker inspect --format='{{index .RepoDigests 0}}' <image>
CAMOFOX_IMAGE=ghcr.io/jo-inc/camofox-browser:latest
SEARXNG_IMAGE=searxng/searxng:latest
SOLVERR_IMAGE=ghcr.io/unseensnick/solverr:latest
CURL_IMAGE=curlimages/curl:latest

# Internal ports (informational - these are set by the images, not by compose)
# Change only if you know what you're doing and update compose accordingly.
CAMOFOX_PORT=9377
ROUTER_PORT=9378
SEARXNG_PORT=8080
SOLVERR_PORT=8191

# Service URLs (for Hermes integration)
SEARXNG_URL=http://searxng:8080
SOLVERR_URL=http://solverr:8191

# Firefox preferences for Camofox (WebRTC off, remote DNS)
CAMOFOX_PREFS_PATH=./camofox/prefs/user.js

# Camofox backends
CAMOFOX_VPS_URL=http://camofox:9377
CAMOFOX_TOR_URL=http://camofox-tor:9377
CAMOFOX_I2P_URL=http://camofox-i2p:9377

# Proxy containers
TOR_SOCKS_HOST=tor-proxy
TOR_SOCKS_PORT=9150
I2P_HTTP_HOST=i2p-proxy
I2P_HTTP_PORT=4444

# v1.0.15: if true, Hermes creates its own searxng/solverr containers
# (only when missing). Leave false if ai-stack provides them.
INSTALL_FULL=false
SEARXNG_SECRET=
# HERMES_RESTART_UNIT=hermes-egress.service

# browser-tor container (optional, see install-browser-tor.sh)
TOR_CONTROL_PASSWORD=
TOR_REQUIRE_NEWNYM=0

# Router authentication (optional, OFF by default)
# The Hermes built-in browser tools do NOT send an Authorization header,
# so enabling this will break them. Use it only if you call the router
# from a custom client that can add the header.
# If set, all requests to camofox-router must include:
#   Authorization: Bearer <ROUTER_API_KEY>
ROUTER_API_KEY=

# Isolated network for tor-proxy / i2p-proxy (created by install.sh)
PROXY_NETWORK=proxy-net
